{
  "name": "raseeda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --fix",
    "ts-lint": "tsc --noEmit --incremental --watch",
    "check-types": "tsc --noEmit",
    "check-types:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "preview": "vite preview",
    "render:home": "bun --preload ./scripts/vite-url-imports.ts scripts/render-homepage-invoices.tsx",
    "encode:home": "bun scripts/encode-homepage-avif.ts",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false",
    "sandcastle:build-image": "sandcastle docker build-image --dockerfile .sandcastle/Dockerfile",
    "sandcastle": "tsx --env-file=.sandcastle/.env .sandcastle/main.mts"
  },

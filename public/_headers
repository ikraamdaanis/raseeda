# Headers for the static files Cloudflare serves from public/ and the build.
# The Worker sets the same security headers on the pages it renders
# (app/server.ts); unit tests check the two copies match.

# Every static file: the baseline security headers from
# consts/security-headers.ts.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# Cache rules. By default every file is revalidated on each visit
# (max-age=0), which costs a round trip before the hero painting can draw.

# Vite's build output: file names carry a content hash, so a changed file
# always gets a new URL and these can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Homepage and template gallery pictures and fonts keep their names. Cache
# them for a month and refresh in the background after that; give a replaced
# image a new file name so visitors pick it up straight away.
/home/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/templates/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Icons and the share image keep their names too, and can't easily be renamed
# (browsers and link previews ask for them by name), so they cache for a week.
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/favicon-96x96.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/web-app-manifest-*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/og-image.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

# The service worker (vite.config.ts) is checked on every visit, so a deploy
# reaches visitors who already have it.
/sw.js
  Cache-Control: no-cache

# The homepage, the template gallery and the privacy page are pre-rendered
# (vite.config.ts) and served as static files, so the Worker that adds this
# policy to every other page never sees them. Keep it identical to
# consts/content-security-policy.ts; a unit test checks.
